# available GPUs to use in this experiment
# if empty, run_experiment will loop over all available GPUs on the computer
# array of integers
avail_gpus=()

# params that are the same across all scenarios in this experiment
# define as a string
same_params="
    test_interval=50000
    t_max=2000000
    test_nepisode=40
    runner=parallel
    env_args.field_size=10
    env_args.players=4
    training_option=single_epoch_update
"

# each experimental scenario involves a grid search over each seed in this array
# array of integers
seeds=(0 2289 3608)

# define the experiment's scenarios
# 1 scenario = 1 combination of params in the arrays below
# define 3 arrays of strings with 1 alg and 1 env per scenario
# this uses 3 arrays b/c dicts in bash are weird
rl_algs=(
    "maic"
    "mappo"
)

envs=(
    "foraging-v2"
    "join1"
)

scenario_params=(
    # "batch_size_run=3 batch_size=32"
    # "batch_size_run=4 batch_size=64"
    # "batch_size_run=5 batch_size=160"
    # "batch_size_run=3 batch_size=96"
    # "batch_size_run=4 batch_size=128"
)

